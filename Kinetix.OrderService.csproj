<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  
    <!-- Without a lock file, `dotnet restore` re-resolves floating and transitive versions on
         every machine, so CI and this laptop can build different dependency graphs from the
         same commit. The lock file is committed and restore fails if it disagrees. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
</PropertyGroup>

  <ItemGroup>
    <!-- The wire contracts, fetched by bin/sync-contracts at a pinned commit. Not committed
         here: this repository tracks no .proto at all, which is what S9 measures.
         ProtoRoot is set so cross-package imports (common/v1/common.proto) resolve. -->
    <Protobuf Include=".contracts/proto/pricing/v1/pricing.proto" ProtoRoot=".contracts/proto" GrpcServices="Client" />
    <Protobuf Include=".contracts/proto/shipping/v1/shipping.proto" ProtoRoot=".contracts/proto" GrpcServices="Client" />
    <Protobuf Include=".contracts/proto/payment/v1/payment.proto" ProtoRoot=".contracts/proto" GrpcServices="Client" />
    <Protobuf Include=".contracts/proto/identity/v1/identity.proto" ProtoRoot=".contracts/proto" GrpcServices="Client" />
    <!-- The saga reserves stock and gives it back; both live on BinStockService. -->
    <Protobuf Include=".contracts/proto/fulfillment/v1/fulfillment.proto" ProtoRoot=".contracts/proto" GrpcServices="Client" />
    <Protobuf Include=".contracts/proto/fulfillment/v1/task.proto" ProtoRoot=".contracts/proto" GrpcServices="Client" />
    <Protobuf Include=".contracts/proto/fleet/v1/fleet.proto" ProtoRoot=".contracts/proto" GrpcServices="Client" />
    <Protobuf Include=".contracts/proto/order/v1/order.proto" ProtoRoot=".contracts/proto" GrpcServices="Server" />
    <Protobuf Include=".contracts/proto/common/v1/common.proto" ProtoRoot=".contracts/proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.30.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.67.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.70.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Stable, not the 10.0.0-rc.2 builds these were on. net10.0 went GA, and a release candidate is
         unlisted once that happens: CI failed on NU1603 because 10.0.0-rc.2.25410.1 no longer resolves
         from nuget.org. The build only worked locally because the packages were already in ~/.nuget. -->
    <!-- Explicit, though nothing here uses EF Core directly: Npgsql asks for [10.0.4, 11.0.0) and NuGet
         takes the floor, while the test project's InMemory provider asks for 10.0.12. That left the two
         halves of the solution on different EF versions (MSB3277, resolved in favour of the older one) —
         a provider and a model built against different EF Core versions. These two lines name one version
         for the whole graph; move them and the test project's InMemory pin together. Relational needs its
         own line because Npgsql depends on it directly — pinning Microsoft.EntityFrameworkCore alone
         leaves Relational on the floor of Npgsql's range and the conflict stands. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- The Prometheus text exposition on /metrics. OpenTelemetry would also get there, but it
         brings a whole SDK, a pipeline and an exporter to serve one endpoint the estate's
         metrics contract already specifies down to the metric names. -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <!-- Required by `dotnet ef` to read the model at design time. PrivateAssets="all" keeps it
         out of the published output, so the runtime image does not carry tooling it never
         calls. Version tracks Microsoft.EntityFrameworkCore as resolved in packages.lock.json;
         a design-time package on a different EF version reads a different model. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Pinned above the 17.14.8 that Microsoft.EntityFrameworkCore.Design resolves
         transitively, which carries GHSA-w3q9-fxm7-j8fq (high severity). Design-time only:
         `dotnet publish` emits neither, so the runtime image never carried them — verified by
         publishing and listing the output, not by reading PrivateAssets. The pin is here anyway
         because an NU1903 that nobody actions on every build is how a real one gets missed.
         Remove both lines once EFCore.Design resolves a patched MSBuild on its own. -->
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.14.28">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
