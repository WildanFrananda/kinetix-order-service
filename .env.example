# Copy to .env and fill every secret in. Values are intentionally blank: services
# fail to start when a required secret is missing rather than falling back to a
# shared committed default (S1 / P0-SEC-02).
# Generate one with:  head -c 48 /dev/urandom | base64
# Never commit the filled-in .env, and never reuse a value across services.

PORT=8001
DATABASE_URL=Host=localhost;Port=5435;Database=kinetix_order_dev;Username=kinetix_order_app;Password=
REDIS_CONNECTION_STRING=localhost:6379
PRICING_GRPC_URL=http://localhost:50054
MATCHING_GRPC_URL=http://localhost:50053
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_for_security_kinetix_order_service
