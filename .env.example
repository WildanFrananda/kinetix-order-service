# Every variable the service reads. Copy to .env, which is never committed, and fill in the blanks.
# Nothing here has a default in code: the service refuses to start, naming the variable, when a
# required one is unset, empty or unreadable. Values shown are the lab's (kinetix-infrastructure
# compose.yaml); the blank ones are secrets or decisions, where a guess would be dangerous.

# Listeners: REST behind the gateway, gRPC over mTLS for the mesh.
PORT=8001
GRPC_PORT=50055

# The password is kinetix-infrastructure's KINETIX_ORDER_DB_PASSWORD (SOPS). Also the migrator's.
DATABASE_URL=Host=kinetix-order-db;Port=5432;Database=kinetix_order_dev;Username=kinetix_order_app;Password=
# The password is kinetix-infrastructure's KINETIX_INFRA_REDIS_PASSWORD (SOPS).
REDIS_CONNECTION_STRING=kinetix-redis:6379,password=

# gRPC peers. http:// is upgraded to https:// with order's mesh leaf; every peer is mTLS.
PRICING_GRPC_URL=https://kinetix-pricing-service:50054
MATCHING_GRPC_URL=http://kinetix-matching-service:50053
CATALOG_GRPC_URL=http://kinetix-catalog-grpc:50058
WAREHOUSE_GRPC_URL=http://kinetix-warehouse-grpc:50051
IDENTITY_GRPC_URL=http://kinetix-identity-service:50052
PAYMENT_GRPC_URL=http://kinetix-payment-service:50056

# Access tokens are verified against identity's published keys. The issuer differs per environment
# (lab https://identity.kinetix.local, production https://identity.prod.kinetix).
IDENTITY_JWKS_URL=http://kinetix-identity-service:5000/.well-known/jwks.json
JWT_ISSUER=
JWT_AUDIENCE=kinetix

# Who may call which RPC: peer, peer@package.Service or peer@package.Service/Method, comma-separated.
# A grant is a decision; copy compose.yaml's list rather than guessing one.
KINETIX_GRPC_ALLOWED_PEERS=

# Seconds. Every outbound gRPC call, and the geocode call, which identity allows eight.
KINETIX_GRPC_DEADLINE_SECONDS=5
KINETIX_GEOCODE_DEADLINE_SECONDS=10

# Days after delivery before the merchant is paid.
KINETIX_RETURN_WINDOW_DAYS=7

# Checkout compensation: attempts before a saga waits for a person, a worker's lease, and the
# backoff between rounds (base doubles up to max), in seconds.
KINETIX_SAGA_MAX_COMPENSATION_ATTEMPTS=6
KINETIX_SAGA_LEASE_SECONDS=60
KINETIX_SAGA_BACKOFF_BASE_SECONDS=30
KINETIX_SAGA_BACKOFF_MAX_SECONDS=1800

# Rows each background sweep takes per pass.
KINETIX_SAGA_SWEEP_BATCH=20
KINETIX_SETTLEMENT_SWEEP_BATCH=20
KINETIX_DISPATCH_SWEEP_BATCH=20
KINETIX_COMPLETION_SWEEP_BATCH=20

# Seconds of drain after SIGTERM; keep it a few seconds inside the container's stop_grace_period (30s).
KINETIX_SHUTDOWN_TIMEOUT_SECONDS=25

# Migrator only, and only while orders still carry the pre-principal customer_id column: identity's
# gRPC address for the backfill (https://, order's mesh leaf). Production no longer needs it.
IDENTITY_GRPC_TARGET=

# Optional. LOG_LEVEL: trace, debug, info, warn, error, critical, none (unset: appsettings.json).
# KINETIX_BUILD_VERSION: the version on kinetix_build_info (unset: the assembly's own).
# KINETIX_PKI_DIR: where tls.crt, tls.key and ca.pem are mounted (unset: /pki).
# KINETIX_TRUST_DOMAIN: SPIFFE trust domains accepted, comma-separated (unset: kinetix.local).
LOG_LEVEL=info
KINETIX_BUILD_VERSION=
KINETIX_PKI_DIR=/pki
KINETIX_TRUST_DOMAIN=kinetix.local
